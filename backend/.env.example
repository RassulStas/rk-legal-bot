# Copy this file to .env and fill in your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the Gemini model (default: gemini-3.5-flash).
# Pro models require a paid plan; e.g. GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_MODEL=gemini-3.5-flash

# Optional: database for chat persistence and compliance auditing.
# Default: SQLite at backend/chat.db. Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rk_legal_bot

# Optional: RAG pipeline tuning (defaults shown).
# Documents live in backend/legal_docs; vector store in backend/chroma_db.
# RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# RAG_TOP_K=3
# RAG_MAX_DISTANCE=0.6
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150

# Optional: allowed browser origins (comma-separated). Default: * (any domain),
# which lets a public frontend call a separately-hosted backend. Restrict for
# tighter deployments, e.g. CORS_ORIGINS=https://legal.example.com
# CORS_ORIGINS=*
